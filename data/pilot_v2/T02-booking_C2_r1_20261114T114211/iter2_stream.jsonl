"\"\n    for s, e in intervals:\n        if e <= s:\n            raise ValueError(\"end must be after start\")\n    merged: list[tuple[datetime, datetime]] = []\n    for s, e in sorted(intervals, key=lambda iv: iv[0]):\n        if merged and s <= merged[-1][1]:\n            last_s, last_e = merged[-1]\n            merged[-1] = (last_s, max(last_e, e))\n        else:\n            merged.append((s, e))\n    return merged\n", "structuredPatch": [{"oldStart": 14, "oldLines": 11, "newStart": 14, "newLines": 14, "lines": ["         return False", "     if start.time() < open_time or end.time() > close_time:", "         return False", "-    buf = timedelta(minutes=buffer_minutes)", "+    return not _conflicts(existing, start, end, timedelta(minutes=buffer_minutes))", "+", "+", "+def _conflicts(existing, start, end, buf) -> bool:", "     for s, e in existing:", "         if not (start >= e + buf or end + buf <= s):", "-            return False", "-    return True", "+            return True", "+    return False", " ", " ", " def merge_intervals(intervals: list[tuple[datetime, datetime]]) -> list[tuple[datetime, datetime]]:"]}], "userModified": false, "replaceAll": false}, "tool_result_meta": [{"id": "anon-000476", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
